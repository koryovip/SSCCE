"handlers": {
  "console": {
    "class": "logging.StreamHandler",
    "formatter": "simple"
  },
  "file": {
    "class": "logging.handlers.RotatingFileHandler",
    "filename": "/logs/mitm.log",
    "maxBytes": 10485760,
    "backupCount": 5,
    "encoding": "utf-8",
    "formatter": "simple"
  }
},
"loggers": {
  "addon": {
    "level": "DEBUG",
    "handlers": ["console", "file"],
    "propagate": false
  }
}
